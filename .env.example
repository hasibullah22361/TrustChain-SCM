# ==========================================
# TrustChain SCM - Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL / SQLite Fallback)
# For local PostgreSQL: postgresql+psycopg://user:password@localhost:5432/trustchain_db
# For hosted Postgres (Neon, Supabase, Railway): postgresql+psycopg://user:pass@host/dbname?sslmode=require
# If empty or unreachable, automatically uses local SQLite: sqlite:///database/trustchain.db
DATABASE_URL=sqlite:///database/trustchain.db

# Blockchain / Web3 Configuration
# Sepolia RPC URL (e.g. Infura, Alchemy, or public RPC)
RPC_URL=https://rpc.sepolia.org
CHAIN_ID=11155111

# Smart Contract Address (Deploy to Sepolia or Local Hardhat)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Deployer / Operator Private Key (Do NOT commit real keys)
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Application Mode: DEMO or LIVE
# Set to 'true' to enable deterministic simulation mode without requiring live Sepolia connection
DEMO_MODE=true

# AI Risk Scoring Thresholds
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_HIGH=0.70
MODEL_VERSION=v1.2.0-xgb
